{
  "name": "helpsenior",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Web e Mobile para ajudar pessoas idosas a organizar atividades e personalizar a experiência digital com acessibilidade.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e:emulator": "firebase emulators:exec --project helpsenior-e2e --only auth,firestore \"pnpm --filter @helpsenior/web test:e2e\"",
    "typecheck": "turbo typecheck"
  },
  "keywords": [
    "accessibility",
    "elderly",
    "senior",
    "react",
    "typescript",
    "monorepo"
  ],
  "author": "Romualdo Borges",
  "license": "MIT",
  "devDependencies": {
    "firebase-tools": "^15.24.0",
    "turbo": "^2.10.3",
    "typescript": "^6.0.3"
  }
}
